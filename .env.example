# Copy this file to .env and fill in local values. Never commit real secrets.

# Gemini — used for PubMed query generation and evidence verification.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_QUERY_MODEL=
GEMINI_VERIFIER_MODEL=

# Groq — optional primary claim extractor from Member 1.
# If missing or unavailable, MythLens automatically falls back to the local/Gemini extractor.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# PubMed / NCBI (optional but recommended)
NCBI_API_KEY=
NCBI_EMAIL=

# Optional: override where Member 2's FAISS + metadata assets are stored
MYTHLENS_VECTOR_PATH=

# Development only. Set to false for normal runs.
MYTHLENS_LLM_DEBUG=false
