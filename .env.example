# Copy this file to .env and fill in local values. Never commit real secrets.

# Gemini — used for evidence verification and Gemini-backed query generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_QUERY_MODEL=
GEMINI_VERIFIER_MODEL=

# Groq — required by the current claim-extraction and transcript-summary pipeline.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# PubMed / NCBI — optional but recommended for higher request limits.
NCBI_API_KEY=
NCBI_EMAIL=

# Optional: override where local FAISS + metadata assets are stored.
MYTHLENS_VECTOR_PATH=

# Development only. Keep false for normal runs.
MYTHLENS_LLM_DEBUG=false
