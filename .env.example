# Copy this file to .env and fill in local values. Never commit real secrets.

# Preferred LLM provider: Ollama running remotely (for example on Colab via ngrok)
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b

# Optional OpenAI fallback. Leave empty if you only want Ollama.
OPENAI_API_KEY=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# PubMed / NCBI (optional but recommended)
NCBI_API_KEY=
NCBI_EMAIL=

# Optional: override where Member 2's FAISS + metadata assets are stored
MYTHLENS_VECTOR_PATH=
